. "$env:TEMP\sc-helpers.ps1"
$more = @'

function Start-Backend {
    $sec = Read-Host "Database password" -AsSecureString
    $env:DB_PASSWORD = [Runtime.InteropServices.Marshal]::PtrToStringAuto(
        [Runtime.InteropServices.Marshal]::SecureStringToBSTR($sec))
    $env:SESSION_COOKIE_SECURE = "false"
    try {
        .\mvnw.cmd spring-boot:run 2>&1 |
            Select-String "Started |APPLICATION FAILED|Description|Port \d+|password authentication|Schema-validation|missing column|wrong column type|Successfully validated|Successfully applied"
    } finally {
        Remove-Item Env:DB_PASSWORD, Env:SESSION_COOKIE_SECURE -ErrorAction SilentlyContinue
    }
}
'@
[System.IO.File]::AppendAllText("$env:TEMP\sc-helpers.ps1", $more, (New-Object System.Text.UTF8Encoding $false))
. "$env:TEMP\sc-helpers.ps1"
Start-Backend